# Full-resolution camera originals must not enter the repo. src/assets/photos holds
# web-sized derivatives only (long edge <= 2400px); originals stay on the Desktop.
*.NEF
*.MOV
src/assets/photos/**/DSC_*.JPG

# --- concert photography -------------------------------------------------
# The repo is PUBLIC. Only photos the site actually displays are committed;
# every other frame stays local, including shots with identifiable third
# parties who did not consent to publication.
#
# Publishing a photo is therefore TWO steps:
#   1. add its import to src/lib/photos.ts
#   2. add a matching "!" line below
# The list mirrors src/lib/photos.ts — keep them in sync.
src/assets/photos/**/*.jpg
