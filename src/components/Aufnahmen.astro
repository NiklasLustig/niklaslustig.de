---
import { Image, getImage } from 'astro:assets';
import Section from './Section.astro';
import { poster } from '../lib/posters';
import { recordings } from '../data/site';

// Privacy: nothing third-party loads until a visitor clicks. The poster is a
// self-hosted copy, so the page makes no request to Google before that.
//
// The first recording carrying a poster is the feature; anything else lists
// underneath as a row. Today that is one video and an empty list.
const feature = recordings.find((r) => r.poster);
const rest = recordings.filter((r) => r !== feature);

const art = feature?.poster ? poster(feature.poster) : undefined;

// The artwork is a portrait poster, so it cannot fill a 16:9 frame on its own.
// A heavily blurred copy fills the gap instead of pillarbox bars. 64px wide is
// plenty once it is blurred, and costs about a kilobyte.
//
// The frame itself is 3:4 on phones and only widens to 16:9 from sm up. Held to
// 16:9 at 375px the poster renders 129px wide and the soloists' names on it are
// unreadable; at 3:4 it nearly fills the frame. The embed is 16:9 either way, so
// a phone reflows once on play — the alternative is a poster nobody can read.
const blur = art ? await getImage({ src: art, width: 64 }) : undefined;
---
{recordings.length > 0 && (
  <Section
    id="aufnahmen"
    eyebrow="Hören"
    heading="Aufnahmen"
    lead="Mitschnitte werden erst geladen, wenn Sie sie starten — vorher wird nichts an Dritte übertragen."
  >
    {feature && art && (
      <figure class="m-0">
        <button
          type="button"
          data-video={feature.src}
          data-title={feature.title}
          class="video-trigger group relative block aspect-[3/4] w-full overflow-hidden rounded-lg border border-[var(--color-line)] bg-ink-raised sm:aspect-video"
          aria-label={`Aufzeichnung abspielen: ${feature.title}`}
        >
          <span
            class="absolute inset-0 scale-125 bg-cover bg-center blur-2xl saturate-50"
            style={`background-image: url(${blur!.src})`}
            aria-hidden="true"
          ></span>
          <!-- The poster is bright cream; without this the blurred fill lights up
               the whole section and fights every other panel on the page. -->
          <span class="absolute inset-0 bg-ink/70" aria-hidden="true"></span>

          <Image
            src={art}
            alt={`Konzertplakat «Mensch Natur Gott», St. Josef Berlin, 31. Mai 2026`}
            widths={[320, 510, 760]}
            sizes="(min-width: 640px) 40vw, 90vw"
            loading="lazy"
            class="relative mx-auto h-full w-auto object-contain shadow-2xl shadow-ink/60"
          />

          <span
            class="absolute inset-0 grid place-items-center transition-colors group-hover:bg-ink/20"
            aria-hidden="true"
          >
            <span class="grid h-20 w-20 place-items-center rounded-full border border-brass/50 bg-ink/70 pl-1 text-3xl text-brass backdrop-blur-sm transition-transform duration-200 group-hover:scale-110 group-hover:bg-brass group-hover:text-ink">
              &#9654;
            </span>
          </span>
        </button>

        <figcaption class="mt-5 sm:flex sm:items-baseline sm:justify-between sm:gap-6">
          <p class="font-display text-parchment" style="font-size: var(--text-h3, 1.5rem)">
            {feature.title}
          </p>
          <p class="mt-1 text-sm text-stone sm:mt-0 sm:shrink-0">{feature.meta}</p>
        </figcaption>
      </figure>
    )}

    {rest.length > 0 && (
      <ul class="mt-10 space-y-3">
        {rest.map((r) => (
          <li>
            {r.kind === 'audio' ? (
              <div class="rounded-lg border border-[var(--color-line)] bg-ink-raised p-5">
                <p class="text-parchment">{r.title}</p>
                <p class="mt-1 text-sm text-stone">{r.meta}</p>
                <audio controls preload="none" src={r.src} class="mt-4 w-full"></audio>
              </div>
            ) : r.kind === 'youtube' ? (
              <button
                type="button"
                data-video={r.src}
                data-title={r.title}
                class="video-trigger group flex w-full items-center gap-4 rounded-lg border border-[var(--color-line)] bg-ink-raised p-5 text-left transition-colors hover:border-brass/50"
              >
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-brass/40 text-brass transition-colors group-hover:bg-brass group-hover:text-ink">&#9654;</span>
                <span>
                  <span class="block text-parchment">{r.title}</span>
                  <span class="block text-sm text-stone">{r.meta}</span>
                </span>
              </button>
            ) : (
              <a
                href={r.src}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-4 rounded-lg border border-[var(--color-line)] bg-ink-raised p-5 transition-colors hover:border-brass/50"
              >
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-brass/40 text-brass transition-colors group-hover:bg-brass group-hover:text-ink">&#9654;</span>
                <span>
                  <span class="block text-parchment">{r.title}</span>
                  <span class="block text-sm text-stone">{r.meta} &nearr;</span>
                </span>
              </a>
            )}
          </li>
        ))}
      </ul>
    )}
  </Section>
)}

<script>
  // Replace the trigger with the embed in place, only once the visitor asks for it.
  document.querySelectorAll<HTMLButtonElement>('.video-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.video;
      if (!id) return;
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
      // The button's textContent would drag in the ▶ glyph and the meta line.
      frame.title = btn.dataset.title ?? 'Aufnahme';
      frame.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
      frame.allowFullscreen = true;
      frame.className = 'aspect-video w-full rounded-lg border border-[var(--color-line)]';
      btn.replaceWith(frame);
    });
  });
</script>
