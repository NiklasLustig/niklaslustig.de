---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import { photo } from '../lib/photos';

// Grouped by concert — the two documented events of 2026. CSS multi-column
// masonry rather than a fixed grid: the set mixes portrait and landscape
// frames, and a row/column grid leaves holes wherever the aspect ratios differ.
const sets = [
  {
    label: '31. Mai 2026 — «Mensch Natur Gott», St. Josef Berlin',
    note: 'Oratorienkonzert. Beethoven, Mendelssohn, Mozart, Weber.',
    shots: [
      { slug: 'dirigat-aufschwung', alt: 'Niklas Lustig dirigiert, beide Arme erhoben' },
      { slug: 'detail-beethoven-partitur', alt: 'Partitur von Beethovens Sechster Symphonie auf dem Dirigentenpult' },
      { slug: 'chor-von-hinten', alt: 'Blick von hinten auf Dirigent und Chor' },
      { slug: 'detail-weber-freischuetz', alt: 'Notenpult mit der Ouvertüre zum Freischütz' },
      { slug: 'portrait-laechelnd', alt: 'Niklas Lustig nach dem Konzert' },
      { slug: 'detail-cello', alt: 'Schnecke und Saiten eines Violoncellos' },
    ],
  },
  {
    label: '16. August 2026 — Abschlusskonzert, Pauluskirche Berlin-Zehlendorf',
    note: 'Orgelkonzert zum Abschluss der Kirchenmusikausbildung.',
    shots: [
      { slug: 'orgel-spieltisch', alt: 'Niklas Lustig am Spieltisch der Orgel' },
      { slug: 'raum-empore', alt: 'Blick auf die Orgelempore der Pauluskirche' },
      { slug: 'haende-manuale', alt: 'Hände auf den Manualen der Orgel' },
      { slug: 'raum-prospekt', alt: 'Orgelprospekt der Pauluskirche Berlin-Zehlendorf' },
      { slug: 'portrait-nach-konzert', alt: 'Niklas Lustig im Gespräch nach dem Konzert' },
    ],
  },
  {
    label: '16. September 2026 — Porträtserie, Museumsinsel Berlin',
    note: 'Aufnahmen an der Alten Nationalgalerie.',
    shots: [
      { slug: 'portraet-bruestung', alt: 'Niklas Lustig an der Brüstung der Alten Nationalgalerie' },
      { slug: 'portraet-kolonnade', alt: 'Niklas Lustig in der Kolonnade der Museumsinsel' },
      { slug: 'portraet-ernst', alt: 'Porträt von Niklas Lustig vor der Freitreppe' },
      { slug: 'portraet-schulter', alt: 'Porträt von Niklas Lustig, an eine Säule gelehnt' },
    ],
  },
];
---
{/* Bewusst zählt die Überschrift nicht mit — Datum und Ort stehen an den
    einzelnen Blöcken, damit ein neuer Block sie nicht veralten lässt. */}
<Section id="bilder" eyebrow="Bilder" heading="Galerie" wide>
  <div class="space-y-16">
    {sets.map((set) => (
      <div>
        <p class="text-sm text-brass">{set.label}</p>
        <p class="mt-1 text-sm text-stone">{set.note}</p>
        <div class="mt-6 columns-2 gap-3 md:columns-3 lg:columns-4 [column-fill:balance]">
          {set.shots.map((s) => (
            <button
              type="button"
              class="lightbox-open group mb-3 block w-full break-inside-avoid overflow-hidden rounded-lg border border-[var(--color-line)]"
              data-alt={s.alt}
              aria-label={`${s.alt} — vergrößern`}
            >
              <Image
                src={photo(s.slug)}
                alt={s.alt}
                widths={[360, 560, 840, 1400]}
                sizes="(min-width: 1024px) 24vw, (min-width: 768px) 32vw, 48vw"
                loading="lazy"
                class="w-full transition-transform duration-500 group-hover:scale-[1.04]"
              />
            </button>
          ))}
        </div>
      </div>
    ))}
  </div>
</Section>

<dialog
  id="lightbox"
  class="fixed inset-0 m-0 h-full max-h-none w-full max-w-none border-0 bg-transparent p-0 backdrop:bg-black/95 backdrop:backdrop-blur-sm"
  aria-label="Bildansicht"
>
  <div id="lightbox-stage" class="relative flex h-full w-full items-center justify-center p-4 sm:p-16">
    <button
      id="lightbox-prev"
      type="button"
      aria-label="Vorheriges Bild"
      class="absolute left-2 top-1/2 z-10 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full border border-brass/35 bg-white/5 text-parchment transition-colors hover:border-brass hover:bg-brass hover:text-ink sm:left-6"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 4 7 12l8 8" /></svg>
    </button>

    <figure class="m-0 flex max-h-full flex-col items-center">
      <img id="lightbox-img" alt="" class="max-h-[76vh] max-w-[84vw] rounded-lg object-contain sm:max-w-[72vw]" />
      <figcaption class="mt-4 flex items-center gap-3 text-sm text-stone">
        <span id="lightbox-cap"></span>
        <span id="lightbox-count" class="text-brass-dim tabular-nums"></span>
      </figcaption>
    </figure>

    <button
      id="lightbox-next"
      type="button"
      aria-label="Nächstes Bild"
      class="absolute right-2 top-1/2 z-10 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full border border-brass/35 bg-white/5 text-parchment transition-colors hover:border-brass hover:bg-brass hover:text-ink sm:right-6"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 4 8 8-8 8" /></svg>
    </button>

    <button
      id="lightbox-close"
      type="button"
      autofocus
      aria-label="Schließen"
      class="absolute right-3 top-3 z-10 grid h-11 w-11 place-items-center rounded-full border border-brass/35 bg-white/5 text-parchment transition-colors hover:border-brass hover:bg-brass hover:text-ink"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
    </button>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const cap = document.getElementById('lightbox-cap');
  const count = document.getElementById('lightbox-count');
  const stage = document.getElementById('lightbox-stage');
  // One list across both concerts, in page order — the arrows walk the whole set.
  const triggers = [...document.querySelectorAll<HTMLButtonElement>('.lightbox-open')];

  if (dialog && img && cap && count && stage && triggers.length) {
    let index = 0;

    const show = (i: number) => {
      // Wrap around at both ends.
      index = (i + triggers.length) % triggers.length;
      const btn = triggers[index];
      // Reuse the srcset the browser already has for the thumbnail, so navigating
      // costs no extra download once a frame has been seen.
      const thumb = btn.querySelector('img');
      if (!thumb) return;
      img.src = thumb.currentSrc || thumb.src;
      img.srcset = thumb.srcset;
      img.sizes = '(min-width: 640px) 72vw, 84vw';
      img.alt = btn.dataset.alt ?? '';
      cap.textContent = btn.dataset.alt ?? '';
      count.textContent = `${index + 1} / ${triggers.length}`;
    };

    const step = (delta: number) => show(index + delta);

    triggers.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      });
    });

    document.getElementById('lightbox-prev')?.addEventListener('click', () => step(-1));
    document.getElementById('lightbox-next')?.addEventListener('click', () => step(1));
    document.getElementById('lightbox-close')?.addEventListener('click', () => dialog.close());

    // Clicking the empty area around the photo closes; the figure and buttons do not.
    stage.addEventListener('click', (e) => { if (e.target === stage) dialog.close(); });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
      // Escape is handled natively by <dialog>.
    });

    // Swipe left/right on touch devices.
    let touchX: number | null = null;
    stage.addEventListener('touchstart', (e) => { touchX = e.changedTouches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      if (touchX === null) return;
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 50) step(dx < 0 ? 1 : -1);
      touchX = null;
    }, { passive: true });
  }
</script>
