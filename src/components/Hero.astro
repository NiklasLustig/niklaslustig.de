---
import { Image } from 'astro:assets';
import Pipes from './Pipes.astro';
import { photo } from '../lib/photos';
import { NAME, ROLE, hero } from '../data/site';

// Editorial split rather than a full-bleed banner: the concert photography is
// portrait-orientation, and a studio portrait will be too. Swapping the hero is
// a one-word change to `hero.image` in src/data/site.ts.
const img = photo(hero.image);
---
<section id="top" class="border-b border-[var(--color-line)]">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-12 sm:py-16 md:grid-cols-[1.1fr_0.9fr] md:items-center md:gap-16 md:py-24">
    <div class="order-2 md:order-1">
      <p class="text-xs uppercase tracking-[0.32em] text-brass">{ROLE}</p>
      <h1
        class="font-display mt-5 leading-[0.98] text-parchment"
        style="font-size: var(--text-claim)"
      >
        {hero.claim}
      </h1>
      <p class="mt-7 text-lg leading-relaxed text-stone">{hero.intro}</p>

      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a
          href="#kontakt"
          class="rounded-full bg-brass px-6 py-3 text-sm font-medium text-ink transition-transform hover:-translate-y-0.5"
        >
          Anfrage senden
        </a>
        <a
          href="#termine"
          class="rounded-full border border-[var(--color-line)] px-6 py-3 text-sm text-parchment transition-colors hover:border-brass/60 hover:text-brass"
        >
          Termine
        </a>
      </div>

      <Pipes count={19} height={64} class="mt-12 opacity-90" />
    </div>

    <div class="order-1 md:order-2">
      <figure class="relative overflow-hidden rounded-lg border border-[var(--color-line)]">
        <Image
          src={img}
          alt={hero.alt}
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 768px) 42vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/5] w-full object-cover md:aspect-[3/4]"
        />
        <figcaption class="sr-only">{NAME}, {ROLE}</figcaption>
      </figure>
    </div>
  </div>
</section>
