---
import Section from './Section.astro';
import { getCollection } from 'astro:content';
import { EMAIL } from '../data/site';

const today = new Date().toISOString().slice(0, 10);
const all = (await getCollection('concerts')).map((c) => c.data);
const upcoming = all.filter((c) => c.date >= today).sort((a, b) => a.date.localeCompare(b.date));
const past = all.filter((c) => c.date < today).sort((a, b) => b.date.localeCompare(a.date));

const [next, ...rest] = upcoming;

const fmt = (d: string) =>
  new Intl.DateTimeFormat('de-DE', { weekday: 'short', day: '2-digit', month: 'long', year: 'numeric' })
    .format(new Date(d + 'T00:00:00'));
---
<Section id="termine" eyebrow="Termine" heading="Konzerte">
  {next ? (
    <div class="rounded-lg border border-brass/30 bg-ink-raised p-7 sm:p-10">
      <p class="text-xs uppercase tracking-[0.32em] text-brass">Als Nächstes</p>
      <p class="mt-4 text-brass">{fmt(next.date)} &middot; {next.time} Uhr</p>
      <h3 class="font-display mt-2 text-parchment" style="font-size: var(--text-h2)">{next.title}</h3>
      <p class="mt-3 text-stone">{next.venue}, {next.city}</p>
      {next.role && <p class="mt-1 text-sm text-brass-dim">{next.role}</p>}
      {next.program && <p class="mt-3 text-sm text-stone">Programm: {next.program}</p>}
      {next.note && <p class="mt-1 text-sm text-stone/80">{next.note}</p>}
      {next.ticketUrl && (
        <a href={next.ticketUrl} class="mt-5 inline-block text-sm text-brass underline underline-offset-4">Tickets</a>
      )}
    </div>
  ) : (
    <div class="rounded-lg border border-[var(--color-line)] bg-ink-raised p-7 sm:p-10">
      <p class="text-lg leading-relaxed text-stone">
        Zurzeit sind keine öffentlichen Termine angekündigt. Anfragen für Konzerte und
        Projekte sind jederzeit willkommen.
      </p>
      <a href={`mailto:${EMAIL}`} class="mt-5 inline-block text-sm text-brass underline underline-offset-4">
        Anfrage senden
      </a>
    </div>
  )}

  {rest.length > 0 && (
    <div class="mt-14">
      <p class="mb-4 text-xs uppercase tracking-[0.32em] text-brass">Weitere Termine</p>
      <ul class="divide-y divide-[var(--color-line)] border-y border-[var(--color-line)]">
        {rest.map((c) => (
          <li class="grid gap-2 py-5 sm:grid-cols-[11rem_1fr] sm:gap-8">
            <div class="text-sm text-brass">
              <div>{fmt(c.date)}</div>
              <div class="text-stone">{c.time} Uhr</div>
            </div>
            <div>
              <h3 class="font-display text-lg text-parchment">{c.title}</h3>
              <p class="mt-1 text-stone">{c.venue}, {c.city}</p>
              {c.role && <p class="mt-1 text-sm text-brass-dim">{c.role}</p>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  )}

  {past.length > 0 && (
    <div class="mt-14">
      <p class="mb-4 text-xs uppercase tracking-[0.32em] text-brass">Rückblick</p>
      <ul class="divide-y divide-[var(--color-line)] border-y border-[var(--color-line)]">
        {past.map((c) => (
          <li class="grid gap-2 py-5 sm:grid-cols-[11rem_1fr] sm:gap-8">
            <div class="text-sm text-stone">
              <div>{fmt(c.date)}</div>
              <div>{c.time} Uhr</div>
            </div>
            <div>
              <h3 class="font-display text-lg text-parchment">{c.title}</h3>
              <p class="mt-1 text-stone">{c.venue}, {c.city}</p>
              {c.role && <p class="mt-1 text-sm text-brass-dim">{c.role}</p>}
              {c.program && <p class="mt-1 text-sm text-stone">Programm: {c.program}</p>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  )}
</Section>
