---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import { photo } from '../lib/photos';
import { vita } from '../data/site';

const portrait = photo('portraet-nah');
---
<Section id="vita" eyebrow="Vita" heading="Zur Person">
  <div class="grid gap-12 md:grid-cols-[1.35fr_1fr] md:gap-16">
    <div>
      <div class="space-y-5 text-lg leading-relaxed text-stone">
        {vita.short.map((p) => <p>{p}</p>)}
      </div>

      {vita.long.length > 0 && (
        <details class="mt-8 border-t border-[var(--color-line)] pt-6">
          <summary class="flex items-center gap-3 text-sm uppercase tracking-[0.2em] text-brass">
            <span class="chevron inline-block">&rsaquo;</span>
            Ausführliche Vita
          </summary>
          <div class="mt-5 space-y-5 text-lg leading-relaxed text-stone">
            {vita.long.map((p) => <p>{p}</p>)}
          </div>
        </details>
      )}

      <figure class="mt-12">
        <Image
          src={portrait}
          alt="Porträt von Niklas Lustig, Museumsinsel Berlin"
          widths={[420, 640, 900]}
          sizes="(min-width: 768px) 40vw, 100vw"
          loading="lazy"
          class="w-full max-w-sm rounded-lg border border-[var(--color-line)] object-cover"
        />
      </figure>
    </div>

    <dl class="space-y-5 border-l border-[var(--color-line)] pl-6">
      {vita.facts.map((f) => (
        <div>
          <dt class="text-xs uppercase tracking-widest text-brass">{f.k}</dt>
          <dd class="mt-1 text-parchment">{f.v}</dd>
        </div>
      ))}
    </dl>
  </div>
</Section>
