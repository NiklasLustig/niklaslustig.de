---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';
import { NAME, ROLE, CITY } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: object;
}

const {
  title = `${NAME} — ${ROLE}, ${CITY}`,
  description =
    'Niklas Lustig, Dirigent und Organist in Berlin. Chor- und Orchesterleitung, ' +
    'Orgelkonzerte und Kirchenmusik. Termine, Vita, Aufnahmen und Kontakt.',
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/images/og.jpg', Astro.site).href;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0A0906" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="de_DE" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <slot />
    {/* GoatCounter: cookieless, no personal data, no cross-site tracking.
        Production only, so local development and previews are not counted. */}
    {import.meta.env.PROD && (
      <script
        is:inline
        data-goatcounter="https://niklaslustig.goatcounter.com/count"
        async
        src="https://gc.zgo.at/count.js"
      />
    )}
  </body>
</html>
