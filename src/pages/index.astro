---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import ReferrerGate from '../components/ReferrerGate.astro';
import Hero from '../components/Hero.astro';
import Termine from '../components/Termine.astro';
import Vita from '../components/Vita.astro';
import Repertoire from '../components/Repertoire.astro';
import Aufnahmen from '../components/Aufnahmen.astro';
import Galerie from '../components/Galerie.astro';
import Presse from '../components/Presse.astro';
import Kontakt from '../components/Kontakt.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { NAME, ROLE, CITY, EMAIL } from '../data/site';

const today = new Date().toISOString().slice(0, 10);
const events = (await getCollection('concerts'))
  .map((c) => c.data)
  .filter((c) => c.date >= today)
  .map((c) => ({
    '@context': 'https://schema.org',
    '@type': 'MusicEvent',
    name: c.title,
    startDate: `${c.date}T${c.time}:00`,
    eventStatus: 'https://schema.org/EventScheduled',
    location: { '@type': 'Place', name: c.venue, address: c.city },
    performer: { '@type': 'Person', name: NAME },
  }));

// Person + upcoming events as structured data (helps Google show the musician + concerts)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: NAME,
  jobTitle: ROLE,
  email: `mailto:${EMAIL}`,
  address: { '@type': 'PostalAddress', addressLocality: CITY, addressCountry: 'DE' },
  performerIn: events,
};
---
<Base jsonLd={jsonLd}>
  <ReferrerGate />
  <a href="#main" class="skip-link">Zum Inhalt springen</a>
  <Nav />
  <main id="main">
    <Hero />
    <Termine />
    <Vita />
    <Repertoire />
    <Aufnahmen />
    <Galerie />
    <Presse />
    <Kontakt />
  </main>
  <Footer />
</Base>
